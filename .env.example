# Environment configuration for Clinical Trial Retention Agent
# Copy this file to .env and fill in your credentials.

# --- IBM watsonx credentials (required for live LLM calls) ---
# WATSONX_API_KEY=your_ibm_cloud_api_key
# WATSONX_PROJECT_ID=your_watsonx_project_id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct   # any watsonx chat model that supports tool calling

# --- Free alternative: any OpenAI-compatible API (used if watsonx keys are not set) ---
# Default is Groq's free plan running OpenAI's open-weight gpt-oss-120b.
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key
# Optional overrides (e.g. for Google Gemini or OpenAI):
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# --- Mock mode (set to "true" to skip live LLM calls during local dev) ---
MOCK_LLM=true

# --- Demo participant / trial seed data ---
DEMO_PARTICIPANT_ID=P-1042
DEMO_TRIAL_ID=ONCO-2024-001
