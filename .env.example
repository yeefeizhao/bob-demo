# Environment configuration for Clinical Trial Retention Agent
# Copy this file to .env and fill in your credentials.

# --- IBM watsonx credentials (required for live LLM calls) ---
# WATSONX_API_KEY=your_ibm_cloud_api_key
# WATSONX_PROJECT_ID=your_watsonx_project_id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Mock mode (set to "true" to skip live LLM calls during local dev) ---
MOCK_LLM=true

# --- Demo participant / trial seed data ---
DEMO_PARTICIPANT_ID=P-1042
DEMO_TRIAL_ID=ONCO-2024-001
