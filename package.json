{
  "name": "clinical-trial-retention-agent",
  "version": "0.1.0",
  "description": "Clinical Trial Retention Agent – prototype (NYU Stern / IBM watsonx Capstone)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/web', 'dist/web', {recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "ts-node src/index.ts",
    "demo": "ts-node src/demo.ts",
    "serve": "ts-node src/server.ts",
    "test": "jest --forceExit",
    "record": "node scripts/recordDemo.js"
  },
  "dependencies": {
    "@ibm-cloud/watsonx-ai": "^1.1.2",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "playwright": "^1.65.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ]
  }
}
